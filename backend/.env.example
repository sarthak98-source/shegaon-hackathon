# ─── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=vivmart

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=vivmart_super_secret_jwt_key_change_in_production_2025
